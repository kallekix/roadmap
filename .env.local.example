# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard -> Project Settings -> API)
#
#   cp .env.local.example .env.local
#
# .env.local is gitignored and must never be committed.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Server-only — the secret key (sb_secret_...). Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Long random string; the public read-only Versions view lives at /v/<this>
SHARE_TOKEN=generate-a-long-random-string
