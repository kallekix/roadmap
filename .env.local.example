# Copy this file to .env.local and fill in the values.
#
#   cp .env.local.example .env.local
#
# .env.local is gitignored and must never be committed. Set these SAME values in
# Vercel (Project → Settings → Environment Variables) when you deploy.

# The email you sign in with. Must match the owner email in schema.sql's RLS
# policies. (NEXT_PUBLIC_ so the UI knows who the owner is; the real enforcement
# is the RLS policies, not this value.)
NEXT_PUBLIC_OWNER_EMAIL=you@example.com

# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Server-only — the secret key (sb_secret_...). Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# Long random string; the public read-only view lives at /v/<this>.
# Generate one with:  openssl rand -hex 20
SHARE_TOKEN=generate-a-long-random-string
